// A variant records which case is active, so reading the wrong one is
// impossible. A union does not. Its members share one piece of storage, and
// nothing remembers which was written last.
//
// That is not a weaker variant — it is a different tool. Writing one member and
// reading another reinterprets the same bytes rather than converting them,
// which is how a number's bit pattern is examined directly.
import Io::PrintLine;

// Four members over the same four bytes. Note the commas: a union separates
// its members with them where a struct ends each field with a semicolon.
union Bits {
    asSigned: int32,
    asUnsigned: uint32,
    asBytes: uint8[4]
}

union Uneven {
    small: uint8,
    large: uint64
}

func Main() -> int {
    // A union is as large as its largest member, not the sum of them, because
    // the members overlap rather than sit side by side.
    PrintLine("sizeof(Bits)    {}", sizeof(Bits));
    PrintLine("sizeof(Uneven)  {}   (not 1 + 8)", sizeof(Uneven));

    // Construction names one member. The others are that same storage, read a
    // different way.
    let zero = Bits { asSigned: 0i32 };
    PrintLine("zero as signed   {}", zero.asSigned);
    PrintLine("zero as unsigned {}", zero.asUnsigned);

    // Minus one is every bit set. Read as unsigned that is the largest value
    // the type holds, and read as bytes it is four 255s. A conversion would
    // have produced something else entirely — this is the same bits, reread.
    let punned = Bits { asSigned: -1i32 };
    PrintLine("as signed        {}", punned.asSigned);
    PrintLine("as unsigned      {}", punned.asUnsigned);
    PrintLine("as bytes         {} {} {} {}",
        punned.asBytes[0], punned.asBytes[1], punned.asBytes[2], punned.asBytes[3]);

    // The same trick on a value with structure to see: 256 sets one bit in the
    // second byte, and the byte order of the machine decides which end it
    // appears at.
    let small = Bits { asUnsigned: 256u32 };
    PrintLine("256 as bytes     {} {} {} {}",
        small.asBytes[0], small.asBytes[1], small.asBytes[2], small.asBytes[3]);

    // Nothing above was an error, and that is the point to be careful about.
    // Reading a member that was never written is not a mistake the compiler can
    // catch — it is a defined reinterpretation of whatever bytes are there. If
    // the program needs to know which member is meaningful, it has to track
    // that itself, and at that point a `variant` is the better answer.
    return 0;
}
