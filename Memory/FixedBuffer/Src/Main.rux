// A `FixedBuffer` is an allocator over memory you already have: here, a 64-byte array on the
// stack. It hands that memory out piece by piece, like an arena, but it never asks anyone for
// more. When the buffer is full, `Allocate` fails with `AllocError::OutOfMemory`.
//
// That makes it the allocator for places where real allocation is not allowed or not
// available, and a way to put a hard limit on how much some piece of code may use. Code
// written against `Allocator` does not know the difference; it just sees a refusal sooner.
//
// The storage belongs to you, not to the buffer, so it must outlive the buffer and everything
// handed out of it. As with an arena, `Reset` makes the whole buffer available again and
// invalidates every address it gave out before.
import Allocator::{ AllocError, Allocator, FixedBuffer, Layout };
import Io::PrintLine;

struct Point {
    x: int64;
    y: int64;
}

func Main() throws AllocError {
    var storage: byte[64];
    // Safety: `storage` is a local of this function, so it outlives `buffer`, and nothing else
    // touches it while the buffer hands it out.
    var buffer = unsafe { FixedBuffer(@storage[0] as *var opaque, 64) };
    // Safety: `allocator` is used only in this function, while `buffer` lives and
    // stays where it is.
    let allocator = unsafe { buffer.Handle() };

    // Each point needs 16 bytes, so four fit.
    let layout = Layout::ForValue<Point>();
    var made: int64 = 0;
    loop {
        let block = try allocator.Allocate(layout) catch {
            error => {
                let full = error == AllocError::OutOfMemory;
                PrintLine("point {} refused, out of memory: {}", made + 1, full);
                break;
            }
        };
        made += 1;
        // Safety: `block` is a fresh allocation of `Layout::ForValue<Point>()`, so it is aligned
        // and large enough for one `Point`, and nothing else uses it.
        let point = unsafe { block as *var Point };
        // Safety: as above, `point` addresses fresh storage for one `Point`.
        let (x, y) = unsafe {
            *point = Point { x: made, y: made * made };
            (point.x, point.y)
        };
        PrintLine("point {} at ({}, {}), {} bytes left", made, x, y, buffer.BytesRemaining());
    }

    // After a reset the next request starts again at the front of `storage`.
    buffer.Reset();
    PrintLine("after reset, {} bytes left", buffer.BytesRemaining());
    let again = try allocator.Allocate(layout);
    PrintLine("starts at storage[0]: {}", (again as uint) == (@storage[0] as uint));
}
