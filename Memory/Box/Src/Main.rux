// A `Box<T>` owns one value that lives in allocated memory. `Box<T>::TryCreate(allocator, value)`
// asks the allocator for room, moves the value in, and hands back the box, or fails with an
// `AllocError` if there was no room. (`Box<T>::New(allocator, value)` does the same but treats
// running out of memory as fatal.) From then on the box is the value's one owner.
//
// That ownership is what the raw lessons were missing. Nobody calls `Deallocate`: when the box's
// life ends, its destructor destroys the value and gives the memory back to the allocator it
// came from. And a box cannot be copied, because two owners would release the memory twice.
// Written bare, as in `let owner = apples;`, it is given away, and the old binding can no longer
// be used.
//
// `Get()` lends the value where it sits as a `&T?`, and `GetMutable()` as a `&var T?`; either is
// `none` only for a box whose value `Take` moved out. While the reference is in use the box stays
// borrowed, so it cannot be given away or destroyed under it.
import Allocator::{ AllocError, Allocator, SystemAllocator };
import Allocator::Pointers::Box;
import Io::PrintLine;

struct Tally {
    name: char8[..];
    count: int;
}

extend Tally {
    destructor {
        PrintLine("    destroying the {} tally", self.name);
    }
}

// The box is created and dies inside this call, so its memory is returned before `Main` resumes.
func Count(allocator: Allocator, name: char8[..]) -> !AllocError {
    let boxed = Box<Tally>::TryCreate(allocator, Tally { name, count: 1 })!;
    if let tally? = boxed.Get() {
        PrintLine("    counted {} {}", tally.count, tally.name);
    }
}

// Where a tally's count lives in memory, which changes only if the tally itself is moved.
func Address(tally: &Tally) -> uint {
    return @tally.count as uint;
}

func Main() -> int {
    let allocator = SystemAllocator::New();

    // A refusal from the allocator ends the program with exit status 1.
    PrintLine("a short-lived box:");
    Count(allocator, "pears") !! return 1;

    PrintLine("a box in Main:");
    var apples = Box<Tally>::TryCreate(allocator, Tally { name: "apples", count: 3 }) !! return 1;
    if let tally? = apples.GetMutable() {
        tally.count += 2;
    }
    if let tally? = apples.Get() {
        PrintLine("    {} {}", tally.count, tally.name);
    }

    // Giving the box away hands over the ownership. The value itself stays where it was
    // allocated, so the new owner points at the very same storage. Only the address is kept
    // across the handover, as a number: a reference would keep `apples` borrowed and forbid it.
    let storage = if let tally? = apples.Get() { Address(tally) } else { 0 };
    let owner = apples;
    let moved = if let tally? = owner.Get() { Address(tally) } else { 0 };
    PrintLine("    moved, same storage: {}", moved == storage);

    // Using `apples` from here on is rejected: it was given away. `owner` frees the memory, once.
    PrintLine("end of Main:");
    return 0;
}
