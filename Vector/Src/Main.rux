// The Memory lesson built an array by hand: ask for a size, use it, give it
// back, and get the count right yourself. It could not grow — the size was
// fixed at the moment of asking.
//
// A `Vector<T>` is that done properly. It owns a block, hands out room as
// values are pushed, takes a larger block when it runs out, and releases
// everything when its life ends.
import Allocator::{ Allocator, SystemAllocator };
import Collections::Vector;
import Io::{ Print, PrintLine };

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // It needs an allocator, for the same reason `String` did: owning means
    // having somewhere to keep things. The `<int>` says what it holds.
    var numbers = Vector::Vector<int>(allocator);
    PrintLine("empty      length {}  capacity {}", numbers.Length(), numbers.Capacity());

    // Two different numbers, worth keeping apart. Length is how many values are
    // in it. Capacity is how many would fit before another block is needed.
    for i in 1..=5 {
        numbers.Push(i * 10);
    }
    PrintLine("5 pushes   length {}  capacity {}", numbers.Length(), numbers.Capacity());

    // Capacity grew past what was asked for, on purpose. Taking a bigger block
    // than needed means the next few pushes cost nothing, and growth happens a
    // handful of times rather than once per value.

    // `AsSlice` gives a view of the contents — the same `T[..]` from the Slice
    // lesson, so anything written against slices works on a vector unchanged.
    Print("contents  ");
    let items = numbers.AsSlice();
    for i in 0..items.length {
        Print(" {}", items[i]);
    }
    PrintLine();

    // `Get` returns an `Option`, because an index may be out of range and there
    // is no value to return when it is. The bounds check is in the type.
    match numbers.Get(2u) {
        .Some(value) => PrintLine("index 2    {}", value),
        .None => PrintLine("index 2    out of range")
    }
    match numbers.Get(99u) {
        .Some(value) => PrintLine("index 99   {}", value),
        .None => PrintLine("index 99   out of range")
    }

    // Taking the last value off. It reports whether there was one, and writes
    // it through the out-parameter — an empty vector has nothing to hand back.
    var popped = 0;
    if numbers.TryPop(@popped) {
        PrintLine("popped     {}, leaving {}", popped, numbers.Length());
    }

    numbers.Set(0u, 999);
    PrintLine("after Set  first is {}", numbers.AsSlice()[0]);

    // Nothing here frees anything. The vector's destructor releases its block
    // when it goes out of scope, which is the Ownership lesson doing its job:
    // the memory belongs to the vector, so the vector gives it back.
    return 0;
}
