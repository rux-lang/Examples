// A text file holds characters. A binary file holds the bytes of values
// directly — smaller, faster to read, and unreadable in an editor.
//
// The catch is that a number wider than one byte has to be laid out in some
// order, and machines do not agree on which. That choice is the whole subject
// of this lesson: get it wrong and the file reads back as nonsense.
import Allocator::{ Allocator, SystemAllocator };
import Core::{ LoadLittleEndian, StoreBigEndian, StoreLittleEndian, TargetIsLittleEndian };
import FileSystem::{ DeleteFile, File, OpenOptions };
import Io::{ IoError, Print, PrintLine };
import Path::{ OsString, Path };
import Text::TextError;

func ShowBytes(label: char8[..], bytes: uint8[..]) {
    Print("{:16}", label);
    for i in 0..bytes.length {
        Print(" {:02x}", bytes[i]);
    }
    PrintLine();
}

func Main() -> int {
    // A value chosen so every byte is different and recognisable.
    let value: uint32 = 305419896u32;
    PrintLine("the value       {:#x}", value);
    PrintLine("this machine is little endian: {}", TargetIsLittleEndian());
    PrintLine("");

    // The same four bytes, laid out both ways. Little endian puts the smallest
    // byte first; big endian puts the largest first, which is the order the
    // number is written in.
    var little: uint8[4];
    var big: uint8[4];
    StoreLittleEndian<uint32>(value, @little[0]);
    StoreBigEndian<uint32>(value, @big[0]);
    ShowBytes("little endian", little[..4]);
    ShowBytes("big endian", big[..4]);
    PrintLine("");

    // Neither is right in general. What matters is that whoever writes and
    // whoever reads agree — which is why a file format states its byte order
    // rather than leaving it to whichever machine happens to run the code.

    var system = SystemAllocator();
    let allocator: Allocator = system;
    var error = IoError::Ok();
    var textError = TextError::None;
    var holder = OsString::FromText(allocator, "Bin/example.bin", @textError);
    let path = Path::FromView(holder.View());

    // Writing the bytes themselves. Nothing is converted to text, so four
    // bytes on disk hold a number that would take ten characters written out.
    var writing = File::Open(allocator, path, OpenOptions::Writing(), @error);
    if !writing.IsOpen() {
        PrintLine("could not open for writing");
        return 1;
    }
    var taken: uint = 0;
    var asChars: char8[4];
    for i in 0..4u {
        asChars[i] = little[i] as char8;
    }
    let payload: char8[..] = asChars[..4];
    writing.Write(payload, @taken);
    writing.Close();
    PrintLine("wrote           {} bytes", taken);

    // Reading them back and reassembling the number, using the same order it
    // was written in.
    var reading = File::Open(allocator, path, OpenOptions::Reading(), @error);
    if !reading.IsOpen() {
        PrintLine("could not open for reading");
        return 1;
    }
    var raw: char8[4];
    var filled: uint = 0;
    reading.Read(raw[..4], @filled);
    reading.Close();

    var recovered: uint32 = 0u32;
    var recoveredBytes: uint8[4];
    for i in 0..filled {
        recoveredBytes[i] = raw[i] as uint8;
    }
    LoadLittleEndian<uint32>(@recoveredBytes[0], @recovered);
    PrintLine("read back       {} bytes, value {:#x}", filled, recovered);

    // Had this used `LoadBigEndian` instead, the same four bytes would have
    // produced 0x78563412 — a perfectly valid number, and completely wrong.
    // That is the failure mode worth remembering: mismatched byte order does
    // not error, it just gives the wrong answer.

    DeleteFile(allocator, path);
    return 0;
}
