// A variant case can carry named fields, declared like a struct's: `Rectangle { width: int32;
// height: int32; }`. The pattern for such a case looks like the literal that builds it, with
// names where the values were: `.Rectangle { width, height } =>`.
//
// Each field in the pattern binds a variable. Three spellings cover what you usually need:
//
//     .Circle { radius }                bind the field to a variable of the same name
//     .Circle { radius: r }             bind the field to a name of your choosing
//     .Rectangle { width, height: _ }   ignore a field you do not need
//
// Fields are found by name, so their order in the pattern does not matter. What does matter is
// that every field is mentioned: leave one out and the compiler stops with
//     error: pattern for 'Shape::Rectangle' expects 2 fields, but found 1
// Writing `height: _` is how you say "I know about this field and I do not need it".
import Io::PrintLine;

variant Shape {
    Circle { radius: int32; },
    Rectangle { width: int32; height: int32; },
    Triangle { base: int32; height: int32; }
}

// The shorthand: each field arrives under its own name.
func Area(shape: Shape) -> int32 {
    return match shape {
        .Circle { radius } => 3 * radius * radius,
        .Rectangle { width, height } => width * height,
        .Triangle { base, height } => base * height / 2
    };
}

// Renaming and ignoring. `radius: r` reads the radius into `r`; `height: _` and `base: _` skip the
// fields this question does not need; and the triangle lists its fields in the opposite order.
func Width(shape: Shape) -> int32 {
    return match shape {
        .Circle { radius: r } => 2 * r,
        .Rectangle { width, height: _ } => width,
        .Triangle { height: _, base } => base
    };
}

func Main() -> int {
    let shapes: Shape[3] = [
        Shape::Circle { radius: 5 },
        Shape::Rectangle { width: 4, height: 6 },
        Shape::Triangle { base: 10, height: 3 }
    ];
    for index in 0..3 {
        PrintLine("width {:2}, area {}", Width(shapes[index]), Area(shapes[index]));
    }
    return 0;
}
