// The Version lesson branched on the compiler's version. That is one of
// several things a build knows about itself, and all of them arrive the same
// way: as ordinary values imported from `Core`, readable while compiling.
//
// Because they are known at compile time, `when` can branch on them, and only
// the taken branch reaches the binary.
import Core::{ #build, #source, #target, BuildMode, OptimizationMode };
import Io::PrintLine;

// `#source` describes where the reading expression is. It is filled in at the
// point it appears, so a helper like this reports its caller's file and its own
// enclosing function — useful for diagnostics that should not be typed by hand.
func Trace(message: char8[..]) {
    PrintLine("  [{}:{} in {}] {}", #source.fileName, #source.line, #source.function, message);
}

func Main() -> int {
    // The target being built for. These are values, so they can be printed —
    // but their real use is deciding what to compile.
    PrintLine("compiled for os {} arch {}", #target.os as uint8, #target.arch as uint8);

    // The profile the build is using. A project may define many profiles, but
    // each one is either a debug or a release mode, and that is the part a
    // package can branch on without knowing the project's names for things.
    when #build.mode == BuildMode::Debug {
        // Only this branch exists in a debug build. The other is not compiled
        // at all — not skipped at run time, absent.
        PrintLine("debug build: extra checking is worth its cost here");
    } else {
        PrintLine("release build: the checks above were never compiled in");
    }

    // What the optimizer was asked to favour, which is separate from the mode.
    when #build.optimization == OptimizationMode::None {
        PrintLine("optimization: none, so the output follows the source closely");
    } else when #build.optimization == OptimizationMode::Size {
        PrintLine("optimization: size");
    } else {
        PrintLine("optimization: speed");
    }

    PrintLine("source location:");
    Trace("this message knows where it came from");

    // One piece of this is not yet available. `#config` is meant to carry
    // values a build defines by name — `#config.Get("FEATURE")` and
    // `#config.Has(...)` — so a package can be configured without editing it.
    // The intrinsics behind them are not implemented in the compiler yet, and
    // calling either fails at load, so nothing here uses them. `#build`,
    // `#target`, `#compiler` and `#source` all work today.
    return 0;
}
