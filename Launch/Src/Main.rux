// A small program that waits for you, counts down, and launches something.
//
// Nothing new is introduced here. It is console input from Circle, an array
// from Array, a loop from Loop, and a pause from the Time package — put
// together into something that does one whole thing.
import Allocator::{ Allocator, SystemAllocator };
import Io::{ Print, PrintLine, ReadLine };
import Text::StringBuilder;
import Time::{ Duration, SleepFor };

// A sleep can fail, and a failure has to be dealt with somehow. Here a pause
// that did not happen only makes the countdown quicker, so it is ignored on
// purpose.
func Pause(milliseconds: int64) {
    SleepFor(Duration::FromMilliseconds(milliseconds)) catch { else => {} };
}

func Main() -> int {
    let jokes = [
        "Rux has no garbage collector. It has a borrow checker, which is",
        "  a garbage collector that also judges you.  \u{1F5D1}\u{FE0F}",
        "",
        "`when` runs at compile time, `if` runs at run time, and `else if`",
        "  inside a `when` chain is how you learn to read diagnostics.  \u{1F4D6}",
        "",
        "There are four character widths. There is one `c64` literal prefix",
        "  short of four, which is a story for another release.  \u{1F914}",
        "",
        "`let` is immutable and `var` is mutable. The compiler will remind",
        "  you of this. Warmly. Repeatedly.  \u{1F49B}",
        "",
        "Pre-1.0 means the language is younger than some of its bug reports,",
        "  and moves faster than all of them.  \u{1F3C3}"
    ];

    PrintLine();
    PrintLine("\u{1F680}  RUX MISSION CONTROL  \u{1F680}");
    PrintLine("========================");
    PrintLine();
    for line in jokes {
        PrintLine(line);
    }
    PrintLine();
    Print("Press Enter to launch  \u{1F447}  ");

    // The same input idiom as Circle: a builder on the system allocator, filled
    // by ReadLine. Nothing is done with the text — it is the Enter that counts,
    // so when the input ends before any Enter arrives, there is no launch.
    var system = SystemAllocator();
    let allocator: Allocator = system;
    var builder = StringBuilder(allocator);
    match ReadLine(builder) {
        .Success(_) => {},
        .Failure(_) => {
            PrintLine();
            PrintLine("No Enter, no launch. Mission scrubbed.  \u{1F6D1}");
            builder.Release();
            return 1;
        }
    }
    builder.Release();

    PrintLine();
    var count = 10;
    while count > 0 {
        PrintLine("   T minus {}...", count);
        Pause(300);
        count -= 1;
    }

    PrintLine();
    PrintLine("   \u{1F525} IGNITION \u{1F525}");
    Pause(500);

    // Each frame is one line, so the rocket climbs the terminal as it prints.
    let frames = [
        "                    \u{1F680}",
        "                  \u{1F680}",
        "                \u{1F680}",
        "              \u{1F680}",
        "            \u{1F680}",
        "          \u{1F680}",
        "        \u{1F680}",
        "      \u{1F680}",
        "    \u{1F680}",
        "  \u{1F680}"
    ];
    for frame in frames {
        PrintLine(frame);
        Pause(120);
    }

    PrintLine();
    PrintLine("   \u{2B50}  \u{1F30D}  \u{2B50}      \u{1F468}\u{200D}\u{1F680} waves from the window");
    PrintLine();
    PrintLine("   Liftoff. Somewhere above you, a `let` binding is still");
    PrintLine("   exactly what it was when it launched.  \u{1F6F0}\u{FE0F}");
    PrintLine();
    return 0;
}
