// Handling a fallible with `match` or `catch` is right when this function is
// the one that should decide what a failure means. Often it is not: the
// function is a step in the middle, and a failure should simply become the
// caller's problem.
//
// Written by hand that is the same few lines every time — match, take the
// success, fail with the error unchanged. Postfix `?` is that written once.
import Io::PrintLine;

variant DigitError {
    Empty,
    BadDigit(int)
}

// A small step that can fail, carrying which position was wrong.
func DigitAt(text: char8[..], index: uint) -> int ! DigitError {
    if text.length == 0 {
        fail DigitError::Empty;
    }
    let byte = text[index];
    if byte < c8'0' || byte > c8'9' {
        fail DigitError::BadDigit(index as int);
    }
    return (byte as int) - 48;
}

// The long way. Every failure is matched, and each one is handed straight back
// to the caller — two near-identical blocks that say nothing new.
func FirstTwoByHand(text: char8[..]) -> int ! DigitError {
    var tens = 0;
    match DigitAt(text, 0) {
        .Success(value) => tens = value,
        .Failure(reason) => fail reason
    }
    var units = 0;
    match DigitAt(text, 1) {
        .Success(value) => units = value,
        .Failure(reason) => fail reason
    }
    return tens * 10 + units;
}

// The same function with `?`. On success the expression is the value, so it can
// be used straight away. On failure the enclosing function fails with that
// error immediately, and nothing after the `?` runs.
func FirstTwo(text: char8[..]) -> int ! DigitError {
    let tens = DigitAt(text, 0)?;
    let units = DigitAt(text, 1)?;
    return tens * 10 + units;
}

func Show(label: char8[..], outcome: int ! DigitError) {
    match outcome {
        .Success(value) => PrintLine("{:10} {}", label, value),
        .Failure(DigitError::Empty) => PrintLine("{:10} nothing to read", label),
        .Failure(DigitError::BadDigit(at)) => PrintLine("{:10} not a digit at position {}",
            label, at)
    }
}

func Main() -> int {
    Show("42", FirstTwo("42"));
    Show("4x", FirstTwo("4x"));
    Show("x4", FirstTwo("x4"));

    // Both versions behave identically — `?` is shorthand, not a shortcut.
    Show("by hand", FirstTwoByHand("4x"));

    // The error travels intact. `x4` fails at position 0 and `4x` at position
    // 1, and each `BadDigit` still carries the position it was given, even
    // though neither error was looked at on the way out.

    // Two things `?` requires. The function using it must itself be fallible,
    // since that is where the failure goes. And its error type must have room
    // for the error being passed on: the same type, or a sum such as
    // `! (DigitError | IoError)` that includes it. `?` never translates one
    // error into another by itself. When a step fails with an unrelated error,
    // say how to turn it into yours: `DigitAt(text, 0)? else (e => ...)`.
    return 0;
}
