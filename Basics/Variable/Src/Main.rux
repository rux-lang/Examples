// A binding gives a value a name. `let` names a value that never changes,
// `var` one that does. Reach for `let` first: a name that cannot change is one
// less thing to keep track of while reading the code.
import Io::PrintLine;

func Main() -> int {
    // With no annotation the type comes from the literal. A whole number is an
    // `int`, a fraction is a `float64`, and a character is a `char32` — the
    // widest member of each family, so nothing is lost by default.
    let whole = 5;
    let fraction = 2.5;
    let letter = 'A';
    PrintLine("inferred   {}  {}  {}", whole, fraction, letter);

    // An annotation asks for a different type. An integer literal is written
    // directly at the width requested, but a float literal is a `float64`
    // already, so narrowing one needs the `f32` suffix rather than a bare 2.5.
    let small: int8 = 5;
    let narrow: float32 = 2.5f32;
    PrintLine("annotated  {}  {}", small, narrow);

    // `var` is the binding that may be assigned again, either outright or
    // through a compound operator.
    var counter = 0;
    counter = counter + 1;
    counter += 10;
    PrintLine("counter    {}", counter);

    // A `var` may also be declared now and given its value later, so long as
    // it is assigned before anything reads it.
    var doubled: int;
    doubled = counter * 2;
    PrintLine("doubled    {}", doubled);

    // Two things the compiler refuses. Neither can appear in a program that
    // builds, so they are written here rather than run:
    //
    //     let total = 5;
    //     total = 6;
    //         error: cannot modify immutable variable 'total'
    //         help: declare 'total' with 'var' to make it mutable
    //
    //     let name = 1;
    //     let name = 2;
    //         error: variable 'name' is already declared in this scope
    //
    // The second one is worth meeting early if you come from a language where
    // redeclaring a name quietly shadows the old one. In Rux a name means one
    // thing for the whole scope it is declared in.
    return 0;
}
