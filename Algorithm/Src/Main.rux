// The containers hold values. These functions do things with them, and they
// work on slices — so one set serves arrays, vectors, and anything else that
// can produce a `T[..]`.
import Algorithms::{ Contains, Count, Fold, IndexOf, IndexWhere, MaxIndex, MinIndex, Sort, SortDescending, Sum };
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, Vector };
import Io::{ Print, PrintLine };

func Show(label: char8[..], items: int[..]) {
    Print("{:12}", label);
    for i in 0..items.length {
        Print(" {}", items[i]);
    }
    PrintLine();
}

// A test written as a function, so it can be handed to `IndexWhere` as a value.
func IsNegative(value: int) -> bool {
    return value < 0;
}

// A step for `Fold`, which walks a sequence carrying a running answer.
func AddSquare(total: int, value: int) -> int {
    return total + value * value;
}

func Main() -> ! CollectionError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A push can fail if memory runs out, so each one ends in `?`, handing any
    // failure to `Main` — which is fallible for exactly that reason.
    var numbers = Vector::Vector<int>(allocator);
    numbers.Push(5)?;
    numbers.Push(-2)?;
    numbers.Push(9)?;
    numbers.Push(1)?;
    numbers.Push(-2)?;
    numbers.Push(7)?;
    Show("start", numbers.AsSlice());

    // Searching. Each answers a different question, and the ones that may find
    // nothing return an optional index, `uint?`.
    PrintLine("contains 9   {}", Contains<int>(numbers.AsSlice(), 9));
    PrintLine("count of -2  {}", Count<int>(numbers.AsSlice(), -2));
    match IndexOf<int>(numbers.AsSlice(), 1) {
        at? => PrintLine("1 is at      {}", at),
        none => PrintLine("1 not found")
    }

    // `IndexWhere` takes a function rather than a value, so the question can be
    // anything expressible as a test.
    match IndexWhere<int>(numbers.AsSlice(), IsNegative) {
        at? => PrintLine("first < 0 at {}", at),
        none => PrintLine("none negative")
    }

    match MinIndex<int>(numbers.AsSlice()) {
        at? => PrintLine("smallest at  {}", at),
        none => PrintLine("empty")
    }
    match MaxIndex<int>(numbers.AsSlice()) {
        at? => PrintLine("largest at   {}", at),
        none => PrintLine("empty")
    }

    // Folding walks the sequence carrying a running value. `Sum` is the common
    // case of it; `Fold` is the general one, taking the step as a function.
    PrintLine("sum          {}", Sum<int>(numbers.AsSlice(), 0));
    PrintLine("sum squares  {}", Fold<int, int>(numbers.AsSlice(), 0, AddSquare));

    // Sorting rearranges in place, so it needs a writable slice — `var T[..]`,
    // the writable form of what the Slice lesson introduced. Everything above
    // only read, and took the ordinary kind.
    // `AsSlice` gives a read-only view; `AsMutableSlice` gives one that may be
    // written through, which is what rearranging requires.
    var items = numbers.AsMutableSlice();
    Sort<int>(items);
    Show("sorted", numbers.AsSlice());

    SortDescending<int>(items);
    Show("descending", numbers.AsSlice());

    // Note what did not happen: none of these knew it was working on a vector.
    // They took a slice, which an array produces just as readily, so the same
    // functions serve both.
}
