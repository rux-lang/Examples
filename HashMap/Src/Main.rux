// A vector answers "what is at position 3". A hash map answers "what is stored
// under this key", where the key is whatever suits — a number, a name, an id.
//
// It finds an entry by computing a number from the key and going straight to
// where that number points, so a lookup costs about the same whether the map
// holds ten entries or ten million.
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ EqualsInt32, HashInt32, HashMap, HashSet };
import Io::PrintLine;

func Main() -> int {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // Two functions are handed over along with the allocator: one to hash a
    // key, and one to compare two keys for equality. Hashing finds the likely
    // place; equality confirms the key found there is really the one wanted,
    // since two different keys can hash to the same number.
    //
    // Passing functions as values like this is the Callback lesson's subject.
    var ages = HashMap<int32, int32>(allocator, HashInt32, EqualsInt32);

    ages.Insert(101i32, 34i32);
    ages.Insert(102i32, 28i32);
    ages.Insert(103i32, 45i32);
    PrintLine("entries        {}", ages.Length());

    // `Get` returns an `Option`, because a key may not be there — the same
    // shape as indexing a vector out of range.
    match ages.Get(102i32) {
        .Some(age) => PrintLine("id 102 is      {}", age),
        .None => PrintLine("id 102 unknown")
    }
    match ages.Get(999i32) {
        .Some(age) => PrintLine("id 999 is      {}", age),
        .None => PrintLine("id 999 unknown")
    }

    // Inserting an existing key replaces its value rather than adding a second
    // entry: a key appears at most once.
    ages.Insert(101i32, 35i32);
    PrintLine("after replace  {} entries", ages.Length());
    match ages.Get(101i32) {
        .Some(age) => PrintLine("id 101 is now  {}", age),
        .None => PrintLine("id 101 unknown")
    }

    PrintLine("contains 103   {}", ages.ContainsKey(103i32));
    match ages.Remove(103i32) {
        .Some(age) => PrintLine("removed 103, who was {}", age),
        .None => PrintLine("103 was not there")
    }
    PrintLine("contains 103   {}", ages.ContainsKey(103i32));

    // A set is the same structure with the values left out: it answers only
    // "is this one here", which is the question often actually being asked.
    var seen = HashSet<int32>(allocator, HashInt32, EqualsInt32);
    var added = false;
    seen.Insert(1i32, @added);
    PrintLine("adding 1       new? {}", added);
    seen.Insert(2i32, @added);
    PrintLine("adding 2       new? {}", added);
    seen.Insert(1i32, @added);
    PrintLine("adding 1 again new? {}", added);
    PrintLine("set size       {}", seen.Length());
    PrintLine("set has 2      {}", seen.Contains(2i32));
    PrintLine("set has 7      {}", seen.Contains(7i32));

    // One thing a hash map does not give: order. Entries come back in whatever
    // arrangement the hashing produced, which has nothing to do with the order
    // they were inserted or the order of the keys. When order matters, the
    // next lesson's tree map keeps it.
    return 0;
}
