// A parcel is wrapping paper around a gift. It is tempting to move just the gift out and leave the
// rest, but Rux refuses: a value is moved whole or not at all.
//
//     return <-parcel.1;
//
// error: cannot move field '1' out of droppable value 'parcel'
//   note: partial moves would leave the aggregate with only some fields initialized
//   help: move the complete aggregate or borrow or clone the component explicitly
//
// The same holds for a struct field or an array element. Half a parcel would be a value that is
// partly alive, and the compiler could no longer say what to destroy when its scope ends.
//
// To keep only one part, take the whole value apart instead. Destructuring a tuple with `<-`
// moves every part into a binding of its own, so each part has exactly one owner again. Keep the
// one you want by moving it on; the rest are destroyed when their bindings go out of scope.
import Io::PrintLine;

struct Item {
    name: char8[..];
}

extend Item {
    func =(self: &var Item, other: &Item);

    func ~Item(self: &var Item) {
        PrintLine("    {} destroyed", self.name);
    }
}

// The parcel is a tuple of wrapping and gift. Both parts move out of it, the gift moves on to the
// caller, and the wrapping is left behind to be destroyed as the function returns.
func Unwrap(parcel: (Item, Item)) -> Item {
    let (wrapping, gift) <- parcel;
    PrintLine("    unwrapped the {} from the {}", gift.name, wrapping.name);
    return <-gift;
}

func Main() -> int {
    PrintLine("unwrapping:");
    let gift = Unwrap((Item { name: "paper" }, Item { name: "book" }));
    PrintLine("    reading the {}", gift.name);

    PrintLine("end of Main:");
    return 0;
}
