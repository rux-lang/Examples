// Writing something to a file and reading it back — the whole round trip,
// with the failures that can happen at each step.
//
// Every operation here can fail for reasons outside the program: the disk is
// full, the name is taken, permission is refused. So each one returns a
// fallible — its result, or an `IoError` saying what went wrong — and the
// lesson is as much about checking as about writing.
//
// `Main` is fallible here, so `?` checks each step and passes a failure on,
// ending the program with exit status 1. Its failure side names both errors
// this program can meet: `IoError` from the file system, and `TextError` from
// turning text into a filename.
import Allocator::{ Allocator, SystemAllocator };
import FileSystem::{ DeleteFile, File, OpenOptions };
import Io::{ IoError, PrintLine };
import Path::{ OsString, Path };
import Text::TextError;

func Main() -> ! IoError | TextError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A path is not a string. The operating system has its own idea of what a
    // filename is — its own encoding, its own separator — so text is converted
    // into an `OsString` first, and the `Path` is a view of that. The Path
    // lesson goes into why this matters.
    var holder = OsString::FromText(allocator, "Bin/example.txt")?;
    let path = Path::FromView(holder.View());

    // Opening says what is intended. `Writing` creates the file if it is not
    // there and truncates it if it is; `Reading` requires it to exist. The
    // intent is part of the request rather than something checked afterwards.
    // What comes back is an open file, or the reason there is none.
    var writing = File::Open(allocator, path, OpenOptions::Writing())?;

    // `Write` returns how many bytes it took, because it is allowed to take
    // fewer than it was given. A program writing something large has to loop
    // until everything is gone; here the count is shown instead.
    let taken = writing.Write("first line\nsecond line\n")?;
    PrintLine("wrote     {} bytes", taken);

    // Closing is where a delayed failure finally surfaces, so it is fallible
    // too.
    writing.Close()?;

    // Reading it back. A fresh open, because the write handle was closed.
    var reading = File::Open(allocator, path, OpenOptions::Reading())?;

    // Read into a buffer of a size decided here. `filled` says how much
    // actually arrived — which is not necessarily the buffer's size, and not
    // necessarily the whole file either.
    var buffer: char8[64];
    let filled = reading.Read(buffer[..64])?;
    PrintLine("read      {} bytes", filled);

    // Only the part that was filled is real. The rest of the buffer is
    // whatever it was before, so the slice is cut to `filled` before use.
    let text: char8[..] = buffer[..filled];
    PrintLine("contents:");
    PrintLine("{}", text);

    reading.Close()?;

    // Tidy up, so running this twice behaves the same as running it once.
    DeleteFile(allocator, path)?;
    PrintLine("removed the file");
}
