// A thread outlives the line that started it, so whatever it is given must last as long as the
// thread does. Moving a value in works for one thread. Several threads that need the same large
// value would each need a copy, and a pointer to a local is only safe while that local lives.
//
// An `Arc<T>` (atomically reference-counted) puts one value on the heap and shares it between
// handles. A handle owns its share, so it is never copied implicitly: `Clone` makes another
// handle, which only adds one to a count; the value itself is never duplicated.
// Dropping a handle subtracts one, and the last handle to go destroys the value. It is the `Rc<T>`
// of the Rc lesson with one difference: the count changes through atomic operations, so clones
// can be made and dropped on different threads at the same time.
//
// Through an `Arc<T>` the value is only read. Whatever in it must change while it is shared needs
// its own synchronization, such as an `Atomic<T>` or a `Mutex<T>` inside it.
import Allocator::{ Arc, SystemAllocator };
import Atomic::Atomic;
import Io::PrintLine;
import Thread::{ JoinHandle, Spawn };

// What every till shares: a price list nobody changes, and a counter they all add to.
struct Shop {
    prices: uint64[4];
    sold: Atomic<uint64>;
}

// What a till is given: its own orders, and a handle to the shop.
struct Till {
    orders: uint64[4];
    shop: Arc<Shop>;
}

// Prices the orders from the shared list and counts the items in the shared total. `Get` gives a
// read-only `&Shop`, so `shop.prices[0] = 110;` here is refused:
//
//     error: cannot modify data through immutable reference '&Shop'
func Ring(till: Till) -> uint64 {
    let shop = till.shop.Get();
    var revenue: uint64 = 0;
    for index in 0..4 {
        revenue = revenue + till.orders[index] * shop.prices[index];
        shop.sold.FetchAdd(till.orders[index]);
    }
    return revenue;
}

// A clone shares the value rather than duplicating it.
func Inspect(copy: Arc<Shop>, original: &Arc<Shop>) {
    PrintLine("same shop       {}", copy.SameAs(original));
    PrintLine("handles now     {}", original.Count());
}

func Main() -> int {
    // The first handle. Its storage comes from an allocator, so making it can fail: `TryCreate`
    // throws the refusal, where the `Arc<Shop>(...)` constructor would stop the program.
    let stock = Shop { prices: [120, 250, 75, 499], sold: Atomic<uint64>(0) };
    var shop = try Arc::TryCreate<Shop>(SystemAllocator(), move stock) catch { _ => return 1 };
    PrintLine("handles before  {}", shop.Count());

    // Each till gets a clone of the handle. Every clone points at the same shop, and moves to its
    // thread with the rest of the till. Writing `shop: shop` instead is refused, because a handle
    // is never copied behind your back:
    //
    //     error: cannot copy 'Arc<Shop>', which owns resources
    let first = try Spawn(Ring, Till { orders: [1, 0, 2, 0], shop: shop.Clone() }) catch { _ => return 1 };
    let second = try Spawn(Ring, Till { orders: [0, 3, 0, 1], shop: shop.Clone() }) catch { _ => return 1 };
    let third = try Spawn(Ring, Till { orders: [2, 2, 2, 2], shop: shop.Clone() }) catch { _ => return 1 };
    var tills: JoinHandle<uint64>[3] = [move first, move second, move third];
    for index in 0..3 {
        PrintLine("till {} took     {}", index + 1, tills[index].Join());
    }

    // Every till has finished and dropped its clone, so only `Main`'s handle is left.
    PrintLine("items sold      {}", shop.Get().sold.Load());
    PrintLine("handles after   {}", shop.Count());

    // A clone passed by value lives for as long as the call runs, so meanwhile there are two.
    Inspect(shop.Clone(), shop);

    // The clone went with the call, so this is the only handle again, and it may change the value.
    match shop.GetMutable() {
        .Some(value) => value.prices[0] = 110,
        none => PrintLine("still shared")
    }
    PrintLine("first price     {}", shop.Get().prices[0]);
    return 0;
}
