// Text has appeared in every lesson without being explained. `"hello"` is a
// `char8[..]` — a slice of bytes, borrowed from the program itself, costing no
// allocation because the bytes are already in the binary.
//
// That is enough until text has to be built or kept. Then it needs to live
// somewhere, and somewhere means an allocator. Three types divide the work:
// a view borrows text, a String owns it, and a builder assembles it.
//
// Owning and building can both fail — the bytes may not be valid text, or the
// memory may not be there — so those calls return a fallible with a
// `TextError` on its failure side. `Main` is fallible too, so `?` passes any
// such failure on, ending the program with exit status 1.
import Allocator::{ Allocator, SystemAllocator };
import Io::PrintLine;
import Text::{ String, StringBuilder, StringView, TextError };

func Main() -> ! TextError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // A literal, with two accented letters in it.
    let literal = "héllo wörld";

    // `StringView` is a borrowed look at text that already exists. It allocates
    // nothing and owns nothing — it is to text what a slice is to an array.
    let view = StringView::FromValidated(literal);

    // Here is the distinction worth taking away. `Length` counts bytes, which
    // is what the text occupies. `ScalarCount` counts characters, which is what
    // a reader sees. They differ whenever the text leaves ASCII: é and ö take
    // two bytes each, so eleven characters occupy thirteen bytes.
    PrintLine("text            {}", view);
    PrintLine("bytes           {}", view.Length());
    PrintLine("characters      {}", view.ScalarCount());

    // Neither number is the wrong one — they answer different questions. Use
    // bytes for how much room it takes, characters for how much there is to
    // read. Indexing is by byte, so a program that steps through text one byte
    // at a time will cut a character in half; `IsBoundary` exists to ask.
    PrintLine("byte 1 starts a character  {}", view.IsBoundary(1u));
    PrintLine("byte 2 starts a character  {}", view.IsBoundary(2u));

    // `String` owns its bytes. It has to be given an allocator, because owning
    // means having somewhere to keep them. It returns the `String` or a
    // `TextError` when the bytes are not valid text.
    let owned = String::FromBytes(allocator, literal)?;
    PrintLine("owned copy      {} bytes, {} characters",
        owned.Length(), owned.ScalarCount());

    // Nothing releases it by hand. `String` has a destructor, so the memory
    // goes back when the value's life ends — the Ownership lesson's rule,
    // applied by a standard type.

    // `StringBuilder` is for text assembled a piece at a time. Appending to a
    // `String` would mean a new allocation each time; a builder grows one
    // buffer instead, which is why reading a line uses one. Growing the
    // buffer can fail, so each `Append` is fallible as well.
    var builder = StringBuilder(allocator);
    builder.Append("one")?;
    builder.Append(" two")?;
    builder.Append(" three")?;
    PrintLine("built           {}", builder.View());
    PrintLine("built length    {}", builder.Length());

    // `View` looks at what the builder holds without taking it. To keep the
    // text after the builder is gone, `IntoString` hands over ownership
    // instead — which is what the Circle lesson does with a line of input.
}
