// An enum is a named set of cases over an integer. It says that a value is one
// of a fixed list, which a bare `int` cannot: nothing stops an `int` holding 47
// where a month was meant.
//
// The cases carry no data. A case that needs to carry something is a `variant`,
// which is the next lesson.
import Io::PrintLine;

// The base type is optional and picks how the value is stored. Discriminants
// may be assigned, and any case left unassigned continues from the one before,
// so February is 2 and April is 4.
enum Month: uint8 {
    January = 1,
    February,
    March,
    April
}

// With neither a base type nor assignments, cases number from zero.
enum Level {
    Low,
    Medium,
    High
}

// `match` is an expression as well as a statement, so its arms can produce the
// value that gets returned. Inside a `match` on a `Month`, the type is already
// known, and the cases may be written `.January` rather than `Month::January`.
func Days(month: Month) -> int32 {
    return match month {
        .January => 31i32,
        .February => 28i32,
        .March => 31i32,
        .April => 30i32
    };
}

func Describe(level: Level) -> char8[..] {
    return match level {
        .Low => "take your time",
        .Medium => "keep an eye on it",
        .High => "deal with it now"
    };
}

func Main() -> int {
    // Outside a context that fixes the type, a case is written in full.
    let month = Month::February;
    PrintLine("February has {} days", Days(month));
    PrintLine("March has {} days", Days(Month::March));

    PrintLine("Low    -> {}", Describe(Level::Low));
    PrintLine("High   -> {}", Describe(Level::High));

    // Cases compare as values.
    PrintLine("March == March  {}", Month::March == Month::March);
    PrintLine("March == April  {}", Month::March == Month::April);

    // The discriminant is reachable by casting to the base type, using the same
    // `as` from the Convert lesson.
    PrintLine("January is {}", Month::January as uint8);
    PrintLine("April is   {}", Month::April as uint8);
    PrintLine("Level::High is {}", Level::High as int32);

    // Assigned discriminants are part of what the enum promises. If these
    // numbers are written to a file or sent to another program, inserting a
    // case in the middle silently changes what the old numbers mean — so add
    // cases at the end, or assign every one explicitly.
    return 0;
}
