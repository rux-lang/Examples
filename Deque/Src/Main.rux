// A vector is fast at the end and slow at the front: inserting at position
// zero means shifting everything along to make room.
//
// A `Deque<T>` — a double-ended queue — is the container that is quick at both
// ends. It keeps track of where its contents start as well as where they end,
// so adding at the front moves a marker rather than the elements.
//
// The usual reason to want one is a queue: work arrives at the back and is
// taken from the front, which is exactly the pair of operations a vector is
// bad at.
import Allocator::{ Allocator, SystemAllocator };
import Collections::{ CollectionError, Deque };
import Io::{ Print, PrintLine };

func Show(label: char8[..], queue: &Deque<int>) {
    Print("{:10}", label);
    for i in 0..queue.Length() {
        match queue.Get(i) {
            value? => Print(" {}", value),
            none => Print(" ?")
        }
    }
    PrintLine("   (length {})", queue.Length());
}

func Main() -> ! CollectionError {
    var system = SystemAllocator();
    let allocator: Allocator = system;

    var queue = Deque::Deque<int>(allocator);

    // Built from both directions at once. The two pushed to the back arrive in
    // order; the two pushed to the front arrive in reverse, because each goes
    // in ahead of the one before it. Each push can fail if memory runs out,
    // so each ends in `?`, handing the failure to `Main`.
    queue.PushBack(2)?;
    queue.PushBack(3)?;
    queue.PushFront(1)?;
    queue.PushFront(0)?;
    Show("built", queue);

    // Both ends come off as easily as they went on. Each returns an optional,
    // `int?`, since an empty deque has nothing to give.
    match queue.PopFront() {
        value? => PrintLine("popped front {}", value),
        none => PrintLine("empty")
    }
    match queue.PopBack() {
        value? => PrintLine("popped back  {}", value),
        none => PrintLine("empty")
    }
    Show("after", queue);

    // Which to reach for: a vector when values are only added and removed at
    // the end, a deque when either end is in play. A deque costs a little more
    // per element for the bookkeeping, which is why it is not simply the
    // default.
}
