// The C runtime is the library almost every system has, and the `C` package declares much of it
// for you. Using it means meeting the four shapes every C interface is made of.
//
// C's own types. C's `int` is 32 bits, but Rux's `int` is 64, and C's `long` is 32 bits on
// Windows and 64 elsewhere. So bindings are written in aliases named after C, such as `c_int`,
// `size_t` and `time_t`, which stand for whichever Rux type matches on the target being built.
//
// Opaque pointers. `malloc` returns C's `void *`, which Rux spells `*opaque`: an address with no
// type, which you convert to the type you meant. Handles such as C's `FILE *` go one step
// further: `FILE` is declared as an empty struct, so you can hold one and pass it back, but
// never look inside.
//
// C structs. `tm` is declared field for field in C's order, so Rux reads the struct exactly
// where C wrote it.
//
// Variadic functions. The `...` in `sprintf` accepts any arguments, and nothing checks them
// against the format. You must pass each one at the type its `%` code reads.
//
// None of these calls panics or throws: C reports failure with a sentinel value, such as null or
// a negative count, and the caller has to check for it. The compiler cannot see what a C function
// does with its arguments, so every call, and every read through a pointer C hands back, sits in
// an `unsafe { ... }` block with a `// Safety:` comment saying why it is sound.
import C::{ c_int, free, gmtime, malloc, size_t, sprintf, time_t };
import Io::PrintLine;

func Main() -> int {
    // An opaque pointer becomes a typed one with `as`. Null means there was no memory.
    let capacity: size_t = 64;
    // Safety: `malloc` may be called with any size, and its block, if any, holds bytes.
    let buffer = unsafe { malloc(capacity) as *var char8 };
    if buffer == null {
        PrintLine("malloc failed");
        return 1;
    }
    // Safety: `buffer` came from `malloc`, is freed only here, and is not used afterwards.
    defer unsafe { free(buffer as *var opaque); }

    // `%s` reads the address of zero-terminated bytes, `%d` a C int and `%f` a 64-bit float.
    // sprintf is never told how big the buffer is, so it must be big enough for any result.
    // Safety: the result, 34 bytes and its zero, fits the 64-byte buffer, the literals end in a
    // zero byte, and each argument has the type its `%` code reads.
    let written = unsafe {
        sprintf(buffer, "%s has %d legs and weighs %.1f g".data, "spider".data, 8 as c_int, 0.5)
    };
    if written < 0 {
        PrintLine("sprintf failed");
        return 1;
    }
    // Safety: `sprintf` wrote `written` bytes at the start of `buffer`.
    PrintLine("{} ({} bytes)", unsafe { buffer[..written as uint] }, written);

    // gmtime fills a `tm` struct that the C runtime owns, and returns its address, or null.
    var stamp: time_t = 1000000000;
    // Safety: `@stamp` addresses a live `time_t`, which `gmtime` only reads.
    let calendar = unsafe { gmtime(@stamp) };
    if calendar == null {
        PrintLine("gmtime failed");
        return 1;
    }
    // Safety: `calendar` is not null, checked above, and addresses the C runtime's `tm`, which
    // stays valid until the next `gmtime` call.
    let time = unsafe { *calendar };
    PrintLine("{} seconds after 1970 began was {}-{}-{}, {}:{}:{} UTC", stamp,
        time.tm_year + 1900, time.tm_mon + 1, time.tm_mday,
        time.tm_hour, time.tm_min, time.tm_sec);
    return 0;
}
