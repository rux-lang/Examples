// The primitive types every other type is built from. Each family has members
// of a fixed width, plus one native-width member — `int`, `uint`, `float`,
// `bool`, `char` — whose size matches the target machine.
//
// `let` names a value; the difference between `let` and `var` is the next
// lesson.
import Io::PrintLine;

func Main() -> int {
    // Signed integers, each fixed width shown at the largest value it holds.
    let int8Max: int8 = 127;
    let int16Max: int16 = 32767;
    let int32Max: int32 = 2147483647;
    let int64Max: int64 = 9223372036854775807;
    let nativeInt: int = -1000;
    PrintLine("int8    {}", int8Max);
    PrintLine("int16   {}", int16Max);
    PrintLine("int32   {}", int32Max);
    PrintLine("int64   {}", int64Max);
    PrintLine("int     {}", nativeInt);

    // Unsigned integers hold no negatives, so the same width reaches twice as
    // far in the positive direction.
    let uint8Max: uint8 = 255;
    let uint16Max: uint16 = 65535;
    let uint32Max: uint32 = 4294967295;
    let uint64Max: uint64 = 18446744073709551615;
    let nativeUint: uint = 1000;
    PrintLine("uint8   {}", uint8Max);
    PrintLine("uint16  {}", uint16Max);
    PrintLine("uint32  {}", uint32Max);
    PrintLine("uint64  {}", uint64Max);
    PrintLine("uint    {}", nativeUint);

    // A value and how it is rendered are separate things. These three lines
    // print the same `uint8`, changing only what the placeholder asks for:
    // `b`, `o` and `x` choose the base, and `#` adds the matching prefix.
    // Written out in binary, the eight bits of a `uint8` are visible.
    PrintLine("binary  {:#b}", uint8Max);
    PrintLine("octal   {:#o}", uint8Max);
    PrintLine("hex     {:#x}", uint8Max);

    // Floating point trades exactness for range. Both of these are written
    // from the same digits of pi, but the narrower type keeps fewer of them —
    // the `f32` suffix is what makes a literal narrow.
    let single: float32 = 3.141592653589793f32;
    let double: float64 = 3.141592653589793;
    let nativeFloat: float = 2.718281828459045;
    PrintLine("float32 {}", single);
    PrintLine("float64 {}", double);
    PrintLine("float   {}", nativeFloat);

    // A placeholder can also ask for fewer digits. `.3` rounds the rendering
    // to three decimal places and leaves the stored value untouched. Width,
    // alignment and the rest of the grammar come later, in the Format lesson.
    PrintLine("rounded {:.3}", nativeFloat);

    // Booleans also come in several widths, which matters when a value has to
    // match the layout a C library expects.
    let flag8: bool8 = true;
    let flag16: bool16 = false;
    let flag32: bool32 = true;
    let nativeBool: bool = false;
    PrintLine("bool8   {}", flag8);
    PrintLine("bool16  {}", flag16);
    PrintLine("bool32  {}", flag32);
    PrintLine("bool    {}", nativeBool);

    // A character literal carries its width in the prefix: `c8`, `c16`, `c32`.
    // An unprefixed literal is a `char`, wide enough for any code point.
    let latin: char8 = c8'W';
    let cyrillic: char16 = c16'Я';
    let greek: char32 = c32'π';
    let nativeChar: char = 'Ψ';
    PrintLine("char8   {}", latin);
    PrintLine("char16  {}", cyrillic);
    PrintLine("char32  {}", greek);
    PrintLine("char    {}", nativeChar);
    return 0;
}
