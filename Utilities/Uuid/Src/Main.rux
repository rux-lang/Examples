// A UUID (universally unique identifier) is 16 bytes used as a name that nobody else will pick:
// a database row, an uploaded file, a request in a log. Its text form is 32 hexadecimal digits
// in groups of 8-4-4-4-12, such as 123e4567-e89b-42d3-a456-426614174000.
//
// The usual kind, version 4, is 122 random bits plus 6 bits marking the version and layout. With
// that many random bits, two programs that never talk to each other will still, in practice,
// never produce the same one. `Random()` makes one from the operating system's entropy, so like
// any request for entropy it can throw an `EntropyError`.
//
// `Parse` reads the text form and throws a `UuidParseError` when it is wrong. It is strict:
// upper case is accepted, since it means the same, but braces, missing hyphens or stray
// characters are refused, with the byte where the text went wrong. Printing with `{}` always
// writes the one canonical form, in lower case.
import Io::PrintLine;
import Uuid::{ Parse, Random, Uuid, UuidParseError };

func Reason(error: UuidParseError) -> char8[..] {
    return match error {
        .WrongLength(_) => "wrong length",
        .Misplaced(_) => "hyphen in the wrong place",
        .NotHexadecimal(_) => "not a hexadecimal digit",
        .BadPrefix(_) => "not a urn:uuid: prefix"
    };
}

func Show(text: char8[..]) {
    try {
        let id = Parse(text);
        PrintLine("{:<45} -> {}", text, id);
    } catch {
        error => PrintLine("{:<45} -> {} at byte {}", text, Reason(error), error.Offset())
    }
}

func Main() -> int {
    Show("123e4567-e89b-42d3-a456-426614174000");
    Show("123E4567-E89B-42D3-A456-426614174000");
    Show("urn:uuid:123e4567-e89b-42d3-a456-426614174000");
    Show("123e4567e89b42d3a456426614174000");
    Show("123e4567-e89b-42d3-a456-42661417400g");
    Show("{123e4567-e89b-42d3-a456-426614174000}");

    // Two spellings, one identifier: comparison is on the 16 bytes, not on the text.
    let lower = try Parse("123e4567-e89b-42d3-a456-426614174000") catch { _ => Uuid::Nil() };
    let upper = try Parse("123E4567-E89B-42D3-A456-426614174000") catch { _ => Uuid::Nil() };
    PrintLine("same identifier: {}", lower.Equals(upper));
    PrintLine("the nil UUID:    {}", Uuid::Nil());

    // A fresh random one, different on every run.
    try {
        let id = Random();
        PrintLine("a new one:       {}  version {}", id, id.Version());
    } catch {
        _ => PrintLine("no entropy for a new UUID")
    }
    return 0;
}
