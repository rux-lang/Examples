// A variable can have an interface as its type. `let shape: &Shape = wheel;` borrows the circle
// as a Shape: a view of it, together with a note of which type it is.
//
// A call such as `shape.Area()` follows the note to Circle's own `Area`. Borrow a rectangle the
// same way and the very same call runs Rectangle's `Area` instead. Which function runs is decided
// while the program runs, by the value behind the view, not by anything written at the call.
// That is called dynamic dispatch, and it is what lets values of different types share one
// function, one array, or one loop.
//
// A view is a borrow, so it lasts as long as the code using it. To keep a Shape in an array or a
// field, a program stores an interface value, `Shape` without the `&`. That is a handle: the
// address of the shape and its note, copying nothing. A handle points at a value that lives
// elsewhere, so it is made from the value's address inside `unsafe`, where the program promises
// the value outlives the handle.
import Io::PrintLine;

interface Shape {
    func Area() -> float64;
    func Name() -> char8[..];
}

struct Circle {
    radius: float64;
}

struct Rectangle {
    width: float64;
    height: float64;
}

extend Circle : Shape {
    func Area(&self) -> float64 {
        return 3.14 * self.radius * self.radius;
    }

    func Name(&self) -> char8[..] {
        return "circle";
    }
}

extend Rectangle : Shape {
    func Area(&self) -> float64 {
        return self.width * self.height;
    }

    func Name(&self) -> char8[..] {
        return "rectangle";
    }
}

func Describe(shape: &Shape) {
    PrintLine("holding a {} with area {}", shape.Name(), shape.Area());
}

func Main() -> int {
    let wheel = Circle { radius: 2.0 };
    let door = Rectangle { width: 1.0, height: 2.0 };

    // The annotation is what turns a circle into a Shape. The view borrows `wheel` and copies
    // nothing.
    let shape: &Shape = wheel;
    PrintLine("holding a {} with area {}", shape.Name(), shape.Area());

    // One function, two types: each call runs the code of the type it was given.
    Describe(wheel);
    Describe(door);

    // A circle and a rectangle cannot share an array: `let shapes = [wheel, door];` is refused
    // with "array element 2 has type 'Rectangle', but element 1 established element type
    // 'Circle'". Two Shape handles can. Writing `[wheel, door]` for them is refused too, with
    // "cannot make interface value 'Shape' from 'Circle'": a handle has to point somewhere.
    // Safety: `wheel` and `door` are locals of `Main` that outlive `shapes` and never move.
    let shapes: Shape[2] = unsafe { [@wheel as Shape, @door as Shape] };
    var total = 0.0;
    for each in shapes {
        total += each.Area();
    }
    PrintLine("total area {}", total);

    // A handle copies nothing, so it sees the value as it is now, not as it was.
    var balloon = Circle { radius: 1.0 };
    // Safety: `balloon` is a local of `Main` that outlives `tracked` and never moves.
    let tracked = unsafe { @balloon as Shape };
    balloon.radius = 2.0;
    PrintLine("the balloon's area is {}, and the handle sees {}", balloon.Area(), tracked.Area());

    // Only what Shape promises can be reached through it. `shape.width` is rejected even when a
    // rectangle is behind it: "interface type 'Shape' has no member 'width'".
    return 0;
}
