// The operators from the Operator lesson are not reserved for the primitive
// types. A type of your own can say what `+`, `==` and `<` mean for it, by
// declaring functions named after the operator.
//
// The point is not cleverness. Money adds to money, and `rent + food` says that
// plainly where `Money { cents: rent.cents + food.cents }` buries it.
import Io::PrintLine;

// Money as a whole number of cents, so no fraction ever goes missing.
struct Money {
    cents: int64;
}

extend Money {
    func Money(cents: int64) -> Money {
        return Money { cents: cents };
    }

    // An operator is a function whose name is the operator. `self` is the left
    // operand; the second parameter is the right one, taken by value.
    func +(self: &Money, other: Money) -> Money {
        return Money { cents: self.cents + other.cents };
    }

    func -(self: &Money, other: Money) -> Money {
        return Money { cents: self.cents - other.cents };
    }

    // The two sides need not be the same type. Multiplying money by a count
    // makes sense; multiplying money by money does not, so only this exists.
    func *(self: &Money, factor: int64) -> Money {
        return Money { cents: self.cents * factor };
    }

    // Comparisons return `bool` rather than the type itself.
    func ==(self: &Money, other: Money) -> bool {
        return self.cents == other.cents;
    }

    func <(self: &Money, other: Money) -> bool {
        return self.cents < other.cents;
    }
}

// Money prints as its parts until it implements Display, so this tidies the
// output. Note the operand here *is* a reference — that is fine for an ordinary
// function, and only operators are fussy about it.
func Show(label: char8[..], amount: &Money) {
    PrintLine("{:11}{:>9} cents", label, amount.cents);
}

func Main() -> int {
    let rent = Money(120000);
    let food = Money(35050);

    // Each of these calls one of the functions above.
    let total = rent + food;
    let extra = rent - food;
    let quarterly = rent * 3;

    Show("rent", rent);
    Show("food", food);
    Show("total", total);
    Show("difference", extra);
    Show("3 rents", quarterly);

    PrintLine("rent == 120000c  {}", rent == Money(120000));
    PrintLine("food < rent      {}", food < rent);

    // One thing worth copying rather than improving on: each operator above
    // takes its right-hand operand *by value*, written `other: Money` and not
    // `other: &Money`. Taking it by reference looks tidier for a large type and
    // is how the standard packages spell an ordinary method — but for an
    // operator it currently compiles and then fails when called. By value is
    // also what `Core`'s own `SemanticVersion` operators do.

    // Only the operators that make sense need defining. `Money` has no `/` and
    // no `>`, and using either is an error rather than something invented on
    // the type's behalf.
    return 0;
}
