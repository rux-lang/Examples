// Reading a line the user types, and turning it into a number that can be
// worked with — including both ways that can fail.
//
// Input needs somewhere to put the text before it exists as a value. A
// `StringBuilder` provides that, and it asks an allocator for the space, which
// is why the String and Allocator lessons come first.
import Allocator::{ Allocator, SystemAllocator };
import Format::ParseFloat64;
import Io::{ Print, PrintLine, ReadLine };
import Math::Pi;
import Text::StringBuilder;

func Main() -> int {
    // The allocator is built as a concrete `SystemAllocator`, then named
    // through the interface the builder asks for. The annotation on the second
    // line is what performs that conversion.
    var system = SystemAllocator();
    let allocator: Allocator = system;

    // `Print` rather than `PrintLine`, so the answer is typed on the same line
    // as the question.
    Print("Circle radius: ");

    var builder = StringBuilder(allocator);

    // The first failure: there was no line to read. `ReadLine` hands back
    // nothing when it succeeds and an `IoError` when it does not, and the end
    // of the input arrives as one of those errors. `IsEnd` means the input
    // ended with nothing before it, which is different from an empty line.
    match ReadLine(builder) {
        .Success(_) => {},
        .Failure(error) => {
            if error.IsEnd() {
                PrintLine("Nothing was entered");
            } else {
                PrintLine("The input could not be read");
            }
            builder.Release();
            return 1;
        }
    }

    // `View` looks at the bytes the builder is holding without taking them
    // away from it, which is all the parser needs.
    //
    // The second failure: there was a line, but it does not spell a number.
    // `ParseFloat64` returns a `float64 ! ParseError` — the number, or the
    // reason it is not one — so both outcomes have to be handled before the
    // value can be used.
    match ParseFloat64(builder.View()) {
        .Success(radius) => {
            PrintLine("Circumference: {:.4}", 2.0 * Pi * radius);
            PrintLine("Area:          {:.4}", Pi * radius * radius);
        },
        .Failure(_) => {
            PrintLine("That is not a number");
            builder.Release();
            return 1;
        }
    }

    // The builder owns memory it asked the allocator for, so it hands it back.
    builder.Release();
    return 0;
}
