// An array holds a fixed number of values of one type, written as a list in
// square brackets. `for` walks an array with the same keyword that walked a
// range in the previous lesson.
import Io::PrintLine;

func Main() -> int {
    // Nothing here says what type this is: it is inferred from the contents as
    // twelve string slices, written `char8[..][12]`. The length is part of the
    // type, which is what makes it an array rather than a growable list.
    //
    // Each string is stored as UTF-8, so a greeting in any script is an
    // ordinary value needing no special handling to print.
    let greetings = [
        "Hello World",
        "你好，世界",
        "नमस्ते दुनिया",
        "Hola Mundo",
        "Bonjour le monde",
        "مرحبا يا عالم",
        "হ্যালো বিশ্ব",
        "Привет мир",
        "Olá Mundo",
        "سلام دنیا",
        "Привіт світ",
        "🐯🐶🐱🐭"
    ];

    // Walking the array binds each element in turn. This is the form to reach
    // for when the body does not care where in the array it is.
    for greeting in greetings {
        PrintLine(greeting);
    }

    // An array knows its own length and is indexed from zero, so the last
    // element sits at `length - 1`.
    PrintLine();
    PrintLine("{} greetings, from {} to {}",
        greetings.length, greetings[0], greetings[greetings.length - 1]);

    // When the position matters, walk a range of indices instead. `..` stops
    // before its upper bound, which is exactly what indexing from zero wants.
    for i in 0..3 {
        PrintLine("index {} holds {}", i, greetings[i]);
    }
    return 0;
}
