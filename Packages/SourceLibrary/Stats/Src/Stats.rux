// A generic function in a source library. The library is never compiled on its own, so there is
// no single machine-code `Largest` here. Each program that depends on the library compiles this
// source along with its own and gets a `Largest` for every element type it actually uses.
pub func Largest<T>(values: T[..]) -> T {
    var best = values[0];
    for value in values {
        if value > best {
            best = value;
        }
    }
    return best;
}
