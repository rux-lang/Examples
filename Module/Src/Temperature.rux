// A second module, in its own file. Its `Convert` and Geometry's functions can
// never be confused, because each name is reached through its own module.
module Module::Temperature {
    func ToFahrenheit(celsius: float64) -> float64 {
        return celsius * 9.0 / 5.0 + 32.0;
    }

    func ToCelsius(fahrenheit: float64) -> float64 {
        return (fahrenheit - 32.0) * 5.0 / 9.0;
    }
}
